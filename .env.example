# Wheelbase — environment configuration
# Copy this file to .env and fill in values as needed.
#
# Credentials are normally configured through the Settings UI (stored encrypted
# via Electron safeStorage). The env vars below are an alternative for
# development / CI where you don't want to go through the UI.

# ---------------------------------------------------------------------------
# Market data (Massive Finance)
# ---------------------------------------------------------------------------
# Get your key at https://massivefinance.com
# MAIN_VITE_ prefix is required so electron-vite picks this up from .env.
# If unset, the app starts without market data (market data features disabled).
MAIN_VITE_MASSIVE_API_KEY=

# ---------------------------------------------------------------------------
# Broker (Alpaca) — dev/CI fallback only
# ---------------------------------------------------------------------------
# These are read at startup only when no credentials are stored in the database.
# For normal use, set your keys through Settings → Alpaca.
# Get paper keys: https://app.alpaca.markets/paper/dashboard/overview
# Get live keys:  https://app.alpaca.markets/live/dashboard/overview
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
# Set to "true" for paper trading, "false" for live (default: paper)
ALPACA_PAPER=true

# ---------------------------------------------------------------------------
# App configuration
# ---------------------------------------------------------------------------
# pino log level: debug | info | warn | error (default: info)
# LOG_LEVEL=debug

# Custom SQLite database path (default: Electron userData directory)
# WHEELBASE_DB_PATH=/path/to/custom.db

# ---------------------------------------------------------------------------
# Development / testing overrides
# ---------------------------------------------------------------------------
# Use fake providers instead of real Alpaca / Massive connections
# FAKE_BROKER=true
# FAKE_MARKET_DATA=true
