# Wheelbase — environment configuration
# Copy this file to .env and fill in values as needed.
#
# Credentials are normally configured through the Settings UI (stored encrypted
# via Electron safeStorage). The env vars below are an alternative for
# development / CI where you don't want to go through the UI.

# ---------------------------------------------------------------------------
# Alpaca — broker AND market data
# ---------------------------------------------------------------------------
# One set of Alpaca keys serves BOTH the broker and market data (IEX stock prices,
# indicative option quotes and Greeks). There is no separate market-data key.
#
# Set them through Settings → Alpaca. They are encrypted via safeStorage and take priority
# over everything else. Without them the app still starts — market data is simply
# unavailable until you connect. Set FAKE_MARKET_DATA=true below to use fixtures instead.
#
# There is deliberately NO way to configure Alpaca credentials from this file. `electron-vite`
# resolves MAIN_VITE_-prefixed values at BUILD time, so a key set here would be inlined in
# plaintext into out/main/index.js and shipped in any packaged build.
#
# For dev and CI, EXPORT the variables for the process instead — those are read at runtime
# and never inlined:
#
#   ALPACA_KEY_ID=... ALPACA_SECRET_KEY=... ALPACA_PAPER=true pnpm dev
#
# Get paper keys: https://app.alpaca.markets/paper/dashboard/overview
# Get live keys:  https://app.alpaca.markets/live/dashboard/overview

# ---------------------------------------------------------------------------
# App configuration
# ---------------------------------------------------------------------------
# pino log level: debug | info | warn | error (default: info)
# LOG_LEVEL=debug

# Custom SQLite database path (default: Electron userData directory)
# WHEELBASE_DB_PATH=/path/to/custom.db

# ---------------------------------------------------------------------------
# Development / testing overrides
# ---------------------------------------------------------------------------
# Use fake providers instead of real Alpaca connections
# FAKE_BROKER=true
# FAKE_MARKET_DATA=true
