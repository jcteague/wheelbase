# Wheelbase — environment configuration
# Copy this file to .env and fill in values as needed.
#
# Credentials are normally configured through the Settings UI (stored encrypted
# via Electron safeStorage). The env vars below are an alternative for
# development / CI where you don't want to go through the UI.

# ---------------------------------------------------------------------------
# Alpaca — broker AND market data
# ---------------------------------------------------------------------------
# One set of Alpaca keys serves BOTH the broker and market data (IEX stock prices,
# indicative option quotes and Greeks). There is no separate market-data key.
#
# For normal use set them through Settings → Alpaca. Those are stored encrypted in the
# database and take priority over everything below. The vars here are the dev/CI fallback,
# used only when nothing is saved. With neither, the app still starts — market data is
# simply unavailable until you connect. Set FAKE_MARKET_DATA=true below to use fixtures.
#
# The MAIN_VITE_ prefix is REQUIRED for values set in this file: electron-vite does not
# copy .env into the main process's process.env, it only exposes MAIN_VITE_-prefixed vars.
# A bare ALPACA_KEY_ID= line here is silently ignored.
# These are inlined into the bundle at build time — never build a distributable with real
# keys in .env.
#
# Get paper keys: https://app.alpaca.markets/paper/dashboard/overview
# Get live keys:  https://app.alpaca.markets/live/dashboard/overview
MAIN_VITE_ALPACA_KEY_ID=
MAIN_VITE_ALPACA_SECRET_KEY=
# Set to "true" for paper trading, "false" for live (default: live)
MAIN_VITE_ALPACA_PAPER=true

# Exported shell variables (not this file) override the above — this is how CI and the
# e2e harness force configuration:
#   ALPACA_KEY_ID=... ALPACA_SECRET_KEY=... ALPACA_PAPER=true pnpm dev

# ---------------------------------------------------------------------------
# App configuration
# ---------------------------------------------------------------------------
# pino log level: debug | info | warn | error (default: info)
# LOG_LEVEL=debug

# Custom SQLite database path (default: Electron userData directory)
# WHEELBASE_DB_PATH=/path/to/custom.db

# ---------------------------------------------------------------------------
# Development / testing overrides
# ---------------------------------------------------------------------------
# Use fake providers instead of real Alpaca connections
# FAKE_BROKER=true
# FAKE_MARKET_DATA=true
